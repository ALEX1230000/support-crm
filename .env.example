# ==========================================================
# Database Configuration
# ==========================================================
# Local development default (uses local SQLite file):
DATABASE_URL="file:support_crm.db"

# Turso (Remote Serverless SQLite) for persistent Vercel production deployment:
# 1. Create a free database at https://turso.tech
# 2. Add these two environment variables to your Vercel project settings:
# DATABASE_URL="libsql://your-database-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"
